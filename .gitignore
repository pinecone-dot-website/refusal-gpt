*.pyc
__pycache__/

# Hugo build output and asset cache — both regenerated by `hugo`.
web/public/
web/resources/
web/.hugo_build.lock

# The API has its own .gitignore for node_modules/, dist/, and .env.

# Model weights. The fp16 base alone is ~15 GB of safetensors — it belongs in
# the HF cache, not in git history, where it cannot be removed later.
models/
runs/adapters*/
runs/fused*/
*.safetensors
*.gguf

errors.log
scratch/
web/deploy.sh
api/deploy.sh
deploy/create-endpoint.sh
deploy/build-image.sh

# iOS build products and the llama.cpp xcframework (835 MB, built from
# ~/Documents/dev/llama.cpp via ./build-xcframework.sh — not vendored).
ios/**/.build/
ios/**/build/
ios/Frameworks/*.xcframework
ios/*.xcodeproj

# xcodegen output — regenerate with `xcodegen generate` in ios/
ios/RefusalGPT.xcodeproj/
