# LOCAL DEVELOPMENT ONLY. Committed on purpose: it holds no secret. The server
# binds to 127.0.0.1 and the key below grants access to nothing that isn't
# already on your own machine.
#
# The real key lives in /home/eric/refusal-gpt-api/.env on the droplet
# (chmod 600) and is never in this repo. Do not reuse this value there.
PORT=3007
HOST=127.0.0.1

API_KEYS=dev:dev-local-not-a-secret-0123456789

# Left EMPTY on purpose. There is no trained refusal-gpt yet — runs/ has a smoke
# adapter and nothing fused. With no upstream, the demo serves canned lines and
# /v1 returns 503, which is exactly the state the site has to survive anyway.
#
# Once there IS a local GGUF in Ollama, point at it:
#   INFERENCE_URL=http://localhost:11434
#   INFERENCE_API=ollama
#   INFERENCE_MODEL=refusal-7b
INFERENCE_URL=http://127.0.0.1:11434
INFERENCE_API=ollama
INFERENCE_MODEL=refusal-7b
MODEL_ID=refusal-gpt

# The deployed model's usable context, in tokens. MUST match `PARAMETER num_ctx`
# in deploy/Modelfile. Not the architectural limit (Qwen2.5-7B could do 32768) —
# what the Ollama worker is actually configured for, which is what truncates.
# Too generous here and Ollama silently drops the oldest turns instead of the
# API returning a visible 400.
MODEL_CONTEXT_TOKENS=8192
# Tokens held back from the prompt budget for the answer.
MAX_OUTPUT_TOKENS=300

# Generous in dev; the point is to poke at it, not to ration it.
RATE_PER_MIN=120
RATE_PER_DAY=5000
PUBLIC_RATE_PER_MIN=120
PUBLIC_RATE_PER_DAY=5000
PUBLIC_RATE_GLOBAL_PER_DAY=100000

UPSTREAM_TIMEOUT_MS=120000
LOG_LEVEL=info

# `hugo server` runs on :1313 and this API on :3007 — different origins, so the
# browser needs to be told. In production both are one hostname and this is empty.
# 57072 is the hugo dev server's actual port (1313 is taken by another site's
# server, so hugo picked a free one). Without it the browser's preflight fails
# and every reply falls back to the canned lines with no clue why.
ALLOWED_ORIGINS=http://localhost:1313,http://127.0.0.1:1313,http://localhost:57072,http://127.0.0.1:57072

# ── the debug workbench's summariser ──────────────────────────────────────────
# A SECOND model, general-purpose on purpose: the fine-tune is trained not to
# break character and would spend the call refusing. Abliterated because
# docs/ios.md records Apple's on-device model refusing to summarise a
# transcript containing self-harm every time, and a summariser that goes quiet
# on exactly those conversations is worse than none.
#
# Leave BOTH blank in production. /api/summary 404s unless a URL and a model
# are set, so an unset summariser is an absent route, not a disabled one.
SUMMARY_URL=http://127.0.0.1:11434
SUMMARY_MODEL=qwen35-abl-4b
SUMMARY_API=ollama
