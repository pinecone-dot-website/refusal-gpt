# refusal-gpt-api — copy to .env on the droplet at /home/eric/refusal-gpt-api/.env
# NEVER commit the real .env. chmod 600 it.

PORT=3007
HOST=127.0.0.1

# Callers for the /v1/* surface, as label:secret pairs. Labels appear in logs
# and rate-limit buckets; secrets never do. Generate with: openssl rand -hex 24
# Give each consumer its own key so one can be revoked without breaking the rest.
#
# The public landing-page demo does NOT use a key — /api/chat is open and
# limited by IP instead. There is no published key to leak.
API_KEYS=eric:REPLACE_ME_32_CHARS_MINIMUM

# Upstream GPU backend. Leave EMPTY until the RunPod endpoint exists — the demo
# then serves canned lines and /v1 returns a clean 503 rather than hanging. No
# redeploy needed to wire it up later: set this and `pm2 restart refusal-gpt-api`.
#
# For the Ollama image in deploy/, this is the load-balancer endpoint root:
#   INFERENCE_URL=https://<endpoint-id>.api.runpod.ai
#   INFERENCE_API=ollama
INFERENCE_URL=
INFERENCE_TOKEN=
INFERENCE_MODEL=refusal-gpt
INFERENCE_API=ollama

# What we advertise on /v1/models and echo back in responses.
MODEL_ID=refusal-gpt

# The deployed model's usable context, in tokens. MUST match `PARAMETER num_ctx`
# in deploy/Modelfile. Not the architectural limit (Qwen2.5-7B could do 32768) —
# what the Ollama worker is actually configured for, which is what truncates.
# Too generous here and Ollama silently drops the oldest turns instead of the
# API returning a visible 400.
MODEL_CONTEXT_TOKENS=8192
# Tokens held back from the prompt budget for the answer.
MAX_OUTPUT_TOKENS=300

# Keyed callers. per-minute = abuse protection (charged on every request);
# per-day = COST ceiling (charged only when a GPU call is actually made).
RATE_PER_MIN=20
RATE_PER_DAY=500

# The anonymous demo. Per-IP limits keep one visitor from hammering it; the
# GLOBAL daily cap is the one that decides what a bad day costs, because IPs
# are free and this URL is public. When the global cap trips, the demo keeps
# working on canned lines instead of going down.
PUBLIC_RATE_PER_MIN=8
PUBLIC_RATE_PER_DAY=60
PUBLIC_RATE_GLOBAL_PER_DAY=2000

# RunPod cold start on a scaled-to-zero worker runs 1-3 minutes.
UPSTREAM_TIMEOUT_MS=180000
LOG_LEVEL=info

# Empty in production. nginx serves the site and this API from one hostname, so
# the browser never makes a cross-origin request.
ALLOWED_ORIGINS=
